{
  "_comment": "RSI-Bench Batch Benchmark Configuration Example. Copy to config.json or config.yaml (gitignored).",
  "version": "1",
  "output_dir": "results",
  "defaults": {
    "num_turns": 3,
    "prompt": "Generate a random integer. Do NOT output anything else.",
    "system_prompt": null,
    "enable_thinking": true,
    "thinking_budget": 1024,
    "temperature": 1.0,
    "max_tokens": 2048,
    "enable_caching": true,
    "use_local_cache": false
  },
  "api_keys": {
    "anthropic": "${ANTHROPIC_API_KEY}",
    "gemini_interactions": "${GEMINI_API_KEY}",
    "gemini": "${GEMINI_API_KEY}",
    "openai_chat": "${OPENAI_API_KEY}",
    "openai_responses": "${OPENAI_API_KEY}",
    "openai_completion": "${OPENAI_API_KEY}",
    "deepseek": "${DEEPSEEK_API_KEY}",
    "openrouter": "${OPENROUTER_API_KEY}",
    "groq": "${GROQ_API_KEY}",
    "mistral": "${MISTRAL_API_KEY}",
    "together": "${TOGETHER_API_KEY}",
    "cohere": "${COHERE_API_KEY}",
    "generic_openai": ""
  },
  "base_urls": {
    "generic_openai": "http://localhost:11434/v1",
    "deepseek": "https://api.deepseek.com"
  },
  "runs": [
    {
      "name": "offline-mock-simulation",
      "provider": "mock",
      "turns": 3,
      "enabled": true,
      "tags": ["simulation", "offline", "ci"]
    },
    {
      "name": "claude-3-7-sonnet",
      "provider": "anthropic",
      "model": "claude-3-7-sonnet-20250219",
      "turns": 3,
      "thinking": true,
      "thinking_budget": 2048,
      "cache": true,
      "enabled": false,
      "tags": ["reasoning", "anthropic"]
    },
    {
      "name": "gemini-2.5-flash-interactions",
      "provider": "gemini_interactions",
      "model": "gemini-2.5-flash",
      "turns": 3,
      "thinking": true,
      "cache": true,
      "enabled": false,
      "tags": ["gemini", "interactions"]
    },
    {
      "name": "openai-gpt-4o",
      "provider": "openai_chat",
      "model": "gpt-4o",
      "turns": 3,
      "thinking": true,
      "cache": true,
      "enabled": false,
      "tags": ["openai", "chat"]
    },
    {
      "name": "deepseek-reasoner-r1",
      "provider": "deepseek",
      "model": "deepseek-reasoner",
      "turns": 3,
      "thinking": true,
      "cache": true,
      "enabled": false,
      "tags": ["deepseek", "reasoning"]
    },
    {
      "name": "local-ollama-generic",
      "provider": "generic_openai",
      "model": "llama3.3:70b",
      "base_url": "http://localhost:11434/v1",
      "turns": 3,
      "thinking": true,
      "enabled": false,
      "tags": ["local", "ollama"]
    },
    {
      "name": "mistral-large",
      "provider": "mistral",
      "model": "mistral-large-latest",
      "turns": 3,
      "thinking": false,
      "enabled": false,
      "tags": ["mistral"]
    },
    {
      "name": "together-deepseek-r1",
      "provider": "together",
      "model": "deepseek-ai/DeepSeek-R1",
      "turns": 3,
      "thinking": true,
      "enabled": false,
      "tags": ["together", "reasoning"]
    },
    {
      "name": "cohere-command-r-plus",
      "provider": "cohere",
      "model": "command-r-plus-08-2024",
      "turns": 3,
      "thinking": false,
      "enabled": false,
      "tags": ["cohere"]
    }
  ]
}
